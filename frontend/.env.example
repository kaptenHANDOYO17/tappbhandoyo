# ============================================================
#  MountTrack - Frontend Environment Variables
#  Handoyo | 21120124120040 | Teknik Komputer
# ------------------------------------------------------------
#  Copy file ini menjadi .env  ->  cp .env.example .env
#  Semua variabel Vite WAJIB diawali prefix VITE_
# ============================================================

# Base URL REST API backend (tanpa slash di akhir)
# Lokal        : http://localhost:5000
# Setelah deploy: https://nama-project-backend.vercel.app
VITE_API_BASE_URL=http://localhost:5000

# Identitas pembuat (dipakai di halaman Profil)
VITE_APP_NAME=MountTrack
VITE_AUTHOR_NAME=Handoyo
VITE_AUTHOR_NIM=21120124120040
VITE_AUTHOR_PRODI=Teknik Komputer

# ---- Supabase (untuk login, wishlist, my gear, foto profil) ----
# Kunci "anon" memang BOLEH ada di frontend: itu kunci publik,
# dan datanya dijaga oleh Row Level Security di sisi Supabase.
# Yang TIDAK BOLEH di frontend adalah service_role key dan kunci Gemini.
VITE_SUPABASE_URL=https://kquucgissbdkwdwgarjk.supabase.co
VITE_SUPABASE_ANON_KEY=isi_dengan_anon_key
