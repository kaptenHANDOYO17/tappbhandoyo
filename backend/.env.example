# ============================================================
#  MountTrack - Backend Environment Variables
#  Handoyo | 21120124120040 | Teknik Komputer
# ------------------------------------------------------------
#  Copy file ini menjadi .env  ->  cp .env.example .env
#
#  CATATAN PENTING:
#  Jika SUPABASE_URL dan SUPABASE_ANON_KEY DIBIARKAN KOSONG,
#  server otomatis memakai FALLBACK DATA (array JSON lokal di
#  dalam kode). Jadi API tetap bisa langsung dijalankan dan
#  dites tanpa error / tanpa perlu setup database dulu.
# ============================================================

# Port server lokal
PORT=5000

# Daftar origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# ---- Supabase (OPSIONAL - biarkan kosong untuk mode fallback) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Nama tabel di Supabase (hanya dipakai jika SUPABASE_URL diisi)
SUPABASE_TABLE_GUNUNG=gunung
SUPABASE_TABLE_ALAT=alat

# Batas waktu query Supabase sebelum jatuh ke fallback data lokal (ms)
SUPABASE_TIMEOUT_MS=4000
